{
  "nodes": [
    {
      "id": "file:app/api/__init__.py",
      "type": "file",
      "name": "__init__.py",
      "filePath": "app/api/__init__.py",
      "summary": "app/api 패키지 마커 파일. 내용은 비어 있고 `github`, `health`, `telegram` 라우터 모듈을 하나의 패키지로 묶는 역할만 한다.",
      "tags": ["entry-point", "barrel", "package-init", "api"],
      "complexity": "simple",
      "languageNotes": "빈 `__init__.py` 는 Python 에서 디렉터리를 패키지로 표시하는 관용적 방식이다. 재수출 없이 `from app.api import github` 형태로만 쓰인다."
    },
    {
      "id": "file:app/api/health.py",
      "type": "file",
      "name": "health.py",
      "filePath": "app/api/health.py",
      "summary": "`GET /health` 헬스체크 엔드포인트를 제공한다. 프로세스 생존 여부만 보는 게 아니라 `SELECT 1` 로 Neon DB 왕복까지 확인해 커넥션이 살아 있는지 검증한다.",
      "tags": ["api-handler", "health-check", "fastapi", "monitoring"],
      "complexity": "simple"
    },
    {
      "id": "file:app/api/telegram.py",
      "type": "file",
      "name": "telegram.py",
      "filePath": "app/api/telegram.py",
      "summary": "텔레그램 봇 웹훅 라우터. 알림 메시지의 인라인 버튼(👍/👎) 콜백을 시크릿 토큰으로 검증한 뒤 `feedback` 테이블에 사용자 반응으로 기록한다.",
      "tags": ["api-handler", "webhook", "feedback", "fastapi", "validation"],
      "complexity": "moderate",
      "languageNotes": "`hmac.compare_digest` 로 시크릿 토큰을 상수 시간 비교해 타이밍 공격을 막는다. 토스트 응답 실패는 삼켜서 텔레그램 재전달로 인한 피드백 중복 기록을 방지한다."
    },
    {
      "id": "file:app/db/session.py",
      "type": "file",
      "name": "session.py",
      "filePath": "app/db/session.py",
      "summary": "Neon pooled 엔드포인트용 SQLAlchemy async 엔진과 잡 단위 세션 컨텍스트 매니저를 정의한다. libpq 전용 URL 파라미터 제거, pgbouncer 대응(statement cache 비활성화), TLS 컨텍스트 직접 생성까지 연결 준비를 한곳에서 처리한다.",
      "tags": ["database", "session", "sqlalchemy", "connection", "utility"],
      "complexity": "moderate",
      "languageNotes": "asyncpg 는 `sslmode` 같은 libpq 파라미터를 모르므로 URL 에서 걸러낸다. `sslmode` 문자열을 그대로 넘기면 asyncpg 가 `~/.postgresql/root.crt` 를 읽다 비ASCII 홈 경로에서 OSError 로 죽어, `ssl.create_default_context()` 를 직접 넘긴다."
    },
    {
      "id": "file:app/jobs/collect.py",
      "type": "file",
      "name": "collect.py",
      "filePath": "app/jobs/collect.py",
      "summary": "수집 잡. 소스 하나를 폴링해 신규 항목을 `items` 에 적재하고, 연속 실패 횟수를 누적해 임계치(5회)에 닿으면 운영 알림을 보낸다.",
      "tags": ["job", "scheduler", "data-pipeline", "collection", "error-handling"],
      "complexity": "moderate",
      "languageNotes": "실패 기록은 알림 발송 전에 먼저 커밋한다. 알림 채널이 죽었을 때 `fail_count` 증가분까지 롤백되는 것을 막기 위한 의도적인 순서다."
    },
    {
      "id": "file:app/jobs/scheduler.py",
      "type": "file",
      "name": "scheduler.py",
      "filePath": "app/jobs/scheduler.py",
      "summary": "APScheduler(AsyncIOScheduler) 기동 지점. `config/sources.yaml` 을 DB `sources` 테이블에 동기화한 뒤 소스별 폴링 잡, 파이프라인 잡(120초), 발송 잡(180초)을 등록한다.",
      "tags": ["scheduler", "job", "apscheduler", "configuration", "orchestration"],
      "complexity": "moderate",
      "languageNotes": "YAML 이 단일 진실 원천이라 YAML 에서 사라진 소스는 삭제 대신 `enabled=False` 로 비활성화해 과거 수집 이력을 보존한다. 잡마다 `max_instances=1`, `coalesce=True` 로 중복 실행을 막는다."
    },
    {
      "id": "file:app/log.py",
      "type": "file",
      "name": "log.py",
      "filePath": "app/log.py",
      "summary": "structlog 기반 구조화 로깅 설정 모듈. JSON 렌더러로 stdout 에 출력해 `docker logs` 로 그대로 흘러가게 하고, 프로젝트 전역에서 쓰는 `get_logger` 를 제공한다.",
      "tags": ["logging", "utility", "structlog", "configuration", "observability"],
      "complexity": "simple"
    },
    {
      "id": "file:app/main.py",
      "type": "file",
      "name": "main.py",
      "filePath": "app/main.py",
      "summary": "프로젝트 엔트리포인트. FastAPI 앱을 만들고 health·GitHub·텔레그램 라우터를 붙이며, lifespan 훅에서 같은 프로세스에 APScheduler 를 기동하고 종료 시 스케줄러와 DB 엔진을 정리한다.",
      "tags": ["entry-point", "fastapi", "bootstrap", "lifecycle", "api"],
      "complexity": "simple",
      "languageNotes": "`@asynccontextmanager` lifespan 패턴으로 기동·종료를 한 함수에 묶었다. API 서버와 스케줄러를 별도 프로세스로 나누지 않고 한 프로세스에 합친 MVP 구성이다."
    },
    {
      "id": "file:scripts/run_job.py",
      "type": "file",
      "name": "run_job.py",
      "filePath": "scripts/run_job.py",
      "summary": "스케줄러 없이 잡을 수동으로 돌리는 CLI 스크립트. `sync`/`collect`/`pipeline`/`notify` 를 인자 순서대로 한 번씩 실행하며 백필과 로컬 디버깅에 쓴다.",
      "tags": ["script", "cli", "utility", "job", "backfill"],
      "complexity": "simple",
      "languageNotes": "`argparse` 의 `choices=list(JOBS)` 로 잡 이름 검증을 딕셔너리 키에 위임했다. `finally` 에서 `engine.dispose()` 를 호출해 Neon 커넥션을 반드시 닫는다."
    },
    {
      "id": "file:tests/test_session_url.py",
      "type": "file",
      "name": "test_session_url.py",
      "filePath": "tests/test_session_url.py",
      "summary": "`app/db/session.py` 의 URL 변환·TLS 판별·연결 인자 생성 로직을 검증하는 단위 테스트 8종. asyncpg 접두사 재작성, libpq 전용 파라미터 제거, Neon 용 ssl 컨텍스트 주입을 확인한다.",
      "tags": ["test", "unit-test", "pytest", "database", "validation"],
      "complexity": "simple"
    },
    {
      "id": "function:app/api/health.py:health",
      "type": "function",
      "name": "health",
      "filePath": "app/api/health.py",
      "lineRange": [14, 17],
      "summary": "`GET /health` 핸들러. DB 세션을 열어 `SELECT 1` 을 왕복시킨 뒤 `{\"status\": \"ok\"}` 를 반환한다.",
      "tags": ["api-handler", "health-check", "database"],
      "complexity": "simple"
    },
    {
      "id": "function:app/api/telegram.py:telegram_webhook",
      "type": "function",
      "name": "telegram_webhook",
      "filePath": "app/api/telegram.py",
      "lineRange": [22, 50],
      "summary": "`POST /webhook/telegram` 핸들러. 시크릿 토큰을 검증하고 콜백 쿼리를 파싱해 `Feedback` 레코드를 저장한 뒤, 사용자에게 토스트 응답을 보낸다.",
      "tags": ["api-handler", "webhook", "validation", "feedback"],
      "complexity": "moderate"
    },
    {
      "id": "function:app/db/session.py:to_asyncpg_url",
      "type": "function",
      "name": "to_asyncpg_url",
      "filePath": "app/db/session.py",
      "lineRange": [21, 32],
      "summary": "psql 연결 문자열을 `postgresql+asyncpg://` 형식으로 바꾸고 asyncpg 가 이해하지 못하는 libpq 전용 쿼리 파라미터를 제거한다.",
      "tags": ["utility", "url-parsing", "database", "normalization"],
      "complexity": "simple"
    },
    {
      "id": "function:app/db/session.py:requires_tls",
      "type": "function",
      "name": "requires_tls",
      "filePath": "app/db/session.py",
      "lineRange": [35, 36],
      "summary": "URL 의 `sslmode` 값이 `require`/`verify-ca`/`verify-full` 중 하나인지 보고 TLS 연결이 필요한지 판별한다.",
      "tags": ["utility", "url-parsing", "security", "database"],
      "complexity": "simple"
    },
    {
      "id": "function:app/db/session.py:connect_args",
      "type": "function",
      "name": "connect_args",
      "filePath": "app/db/session.py",
      "lineRange": [39, 50],
      "summary": "asyncpg 에 넘길 연결 인자를 만든다. pgbouncer 때문에 statement cache 를 끄고, TLS 가 필요하면 `ssl.create_default_context()` 를 직접 주입한다.",
      "tags": ["utility", "database", "connection", "security"],
      "complexity": "simple"
    },
    {
      "id": "function:app/db/session.py:session_scope",
      "type": "function",
      "name": "session_scope",
      "filePath": "app/db/session.py",
      "lineRange": [61, 69],
      "summary": "잡 하나에 세션 하나를 매핑하는 async 컨텍스트 매니저. 정상 종료 시 커밋하고 예외 발생 시 롤백 후 재전파한다.",
      "tags": ["utility", "database", "session", "transaction"],
      "complexity": "simple"
    },
    {
      "id": "function:app/jobs/collect.py:run_source",
      "type": "function",
      "name": "run_source",
      "filePath": "app/jobs/collect.py",
      "lineRange": [21, 57],
      "summary": "소스 하나를 폴링해 신규 항목 수를 반환한다. 수집 실패 시 `fail_count`·`last_error` 를 기록하고 연속 5회 실패에 도달하면 운영 알림을 보낸다.",
      "tags": ["job", "collection", "error-handling", "data-pipeline"],
      "complexity": "moderate"
    },
    {
      "id": "function:app/jobs/collect.py:run_all_sources",
      "type": "function",
      "name": "run_all_sources",
      "filePath": "app/jobs/collect.py",
      "lineRange": [60, 69],
      "summary": "활성화된 모든 소스를 순서대로 한 번씩 `run_source` 로 돌리고 적재 총합을 반환한다. 수동 실행·백필 용도다.",
      "tags": ["job", "collection", "backfill", "batch"],
      "complexity": "simple"
    },
    {
      "id": "function:app/jobs/scheduler.py:sync_sources",
      "type": "function",
      "name": "sync_sources",
      "filePath": "app/jobs/scheduler.py",
      "lineRange": [21, 43],
      "summary": "`config/sources.yaml` 을 `sources` 테이블에 동기화한다. 이름이 같으면 갱신, 없으면 추가, YAML 에서 빠진 소스는 삭제 대신 비활성화한 뒤 활성 소스 목록을 반환한다.",
      "tags": ["configuration", "database", "synchronization", "job"],
      "complexity": "moderate"
    },
    {
      "id": "function:app/jobs/scheduler.py:start_scheduler",
      "type": "function",
      "name": "start_scheduler",
      "filePath": "app/jobs/scheduler.py",
      "lineRange": [46, 66],
      "summary": "AsyncIOScheduler 를 만들고 소스별 폴링 잡·파이프라인 잡·발송 잡을 등록한 뒤 기동한다. 각 잡은 `max_instances=1` 로 중복 실행을 막는다.",
      "tags": ["scheduler", "apscheduler", "bootstrap", "orchestration"],
      "complexity": "moderate"
    },
    {
