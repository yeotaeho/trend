{
  "nodes": [
    {
      "id": "file:app/pipeline/normalize.py",
      "type": "file",
      "name": "normalize.py",
      "filePath": "app/pipeline/normalize.py",
      "summary": "URL 정규화(스킴·호스트 소문자화, utm 등 추적 파라미터·www·트레일링 슬래시 제거, 쿼리 정렬)와 SHA-256 url_hash 생성, 피드 HTML 조각의 평문 변환을 담당하는 순수 함수 모듈. 중복 판별의 기준 키를 만드는 파이프라인 첫 관문이다.",
      "tags": ["utility", "normalization", "hashing", "pipeline", "pure-function"],
      "complexity": "simple",
      "languageNotes": "쿼리 파라미터를 정렬해 순서만 다른 두 URL 이 동일 해시가 되도록 보장한다."
    },
    {
      "id": "function:app/pipeline/normalize.py:normalize_url",
      "type": "function",
      "name": "normalize_url",
      "filePath": "app/pipeline/normalize.py",
      "lineRange": [17, 30],
      "summary": "URL 을 표준형으로 정리한다. 스킴·호스트를 소문자화하고 www 접두사, 추적 파라미터(utm_/mc_/pk_ 및 fbclid·gclid 등), 트레일링 슬래시, 프래그먼트를 제거한 뒤 남은 쿼리를 정렬해 재조립한다.",
      "tags": ["normalization", "url", "utility", "dedupe"],
      "complexity": "simple"
    },
    {
      "id": "function:app/pipeline/normalize.py:url_hash",
      "type": "function",
      "name": "url_hash",
      "filePath": "app/pipeline/normalize.py",
      "lineRange": [33, 34],
      "summary": "정규화된 URL 문자열의 SHA-256 16진 해시를 반환한다. items 테이블의 url_hash 유니크 제약 키로 쓰인다.",
      "tags": ["hashing", "utility", "dedupe"],
      "complexity": "simple"
    },
    {
      "id": "function:app/pipeline/normalize.py:strip_html",
      "type": "function",
      "name": "strip_html",
      "filePath": "app/pipeline/normalize.py",
      "lineRange": [37, 41],
      "summary": "피드가 주는 HTML 조각에서 태그를 제거하고 엔티티를 언이스케이프한 뒤 공백을 정리해 요약 입력용 평문으로 만든다.",
      "tags": ["sanitization", "utility", "text-processing"],
      "complexity": "simple"
    },
    {
      "id": "file:app/sources/__init__.py",
      "type": "file",
      "name": "__init__.py",
      "filePath": "app/sources/__init__.py",
      "summary": "수집기 패키지의 배럴 모듈. 각 소스 모듈을 import 하는 것만으로 register 데코레이터가 실행돼 타입별 레지스트리가 채워지도록 하고, Source 프로토콜과 레지스트리 헬퍼를 재노출한다.",
      "tags": ["barrel", "entry-point", "registry", "plugin"],
      "complexity": "simple",
      "languageNotes": "Python 에서 데코레이터 등록 부수효과를 노리는 import 는 noqa: F401 로 린터 경고를 억제한다."
    },
    {
      "id": "file:app/sources/base.py",
      "type": "file",
      "name": "base.py",
      "filePath": "app/sources/base.py",
      "summary": "수집기 플러그인 계층의 공통 기반. Source 프로토콜 정의, 타입 이름에서 팩토리로 가는 레지스트리(register/build_source), 그리고 네트워크 오류·429·5xx 에만 지수 백오프로 재시도하는 HTTP GET 헬퍼를 제공한다.",
      "tags": ["plugin", "protocol", "registry", "http-client", "retry"],
      "complexity": "moderate",
      "languageNotes": "Protocol + runtime_checkable 로 상속 없이 구조적 타이핑을 쓰고, tenacity 의 retry_if_exception 에 판별 함수를 넘겨 재시도 대상을 좁힌다."
    },
    {
      "id": "class:app/sources/base.py:Source",
      "type": "class",
      "name": "Source",
      "filePath": "app/sources/base.py",
      "lineRange": [20, 25],
      "summary": "소스 하나가 만족해야 할 구조적 프로토콜. name 속성과 since 이후 항목을 반환하는 비동기 fetch 만 요구해, 새 소스를 상속 없이 파일 하나로 추가할 수 있게 한다.",
      "tags": ["protocol", "type-definition", "plugin"],
      "complexity": "simple"
    },
    {
      "id": "function:app/sources/base.py:register",
      "type": "function",
      "name": "register",
      "filePath": "app/sources/base.py",
      "lineRange": [32, 37],
      "summary": "소스 타입 이름에 팩토리 함수를 묶어 전역 레지스트리에 등록하는 데코레이터를 만든다.",
      "tags": ["registry", "decorator", "plugin"],
      "complexity": "simple"
    },
    {
      "id": "function:app/sources/base.py:build_source",
      "type": "function",
      "name": "build_source",
      "filePath": "app/sources/base.py",
      "lineRange": [40, 43],
      "summary": "SourceConfig 의 type 으로 레지스트리를 조회해 소스 인스턴스를 생성한다. 등록되지 않은 타입이면 KeyError 로 즉시 실패한다.",
      "tags": ["factory", "registry", "plugin"],
      "complexity": "simple"
    },
    {
      "id": "function:app/sources/base.py:registered_types",
      "type": "function",
      "name": "registered_types",
      "filePath": "app/sources/base.py",
      "lineRange": [46, 47],
      "summary": "현재 레지스트리에 등록된 소스 타입 이름을 정렬해 반환한다.",
      "tags": ["registry", "introspection", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:app/sources/base.py:retryable",
      "type": "function",
      "name": "retryable",
      "filePath": "app/sources/base.py",
      "lineRange": [50, 57],
      "summary": "예외가 재시도할 가치가 있는지 판별한다. 전송 오류와 429·5xx 만 True 이고, 401·404 처럼 다시 해도 결과가 같은 영구 오류는 False 다.",
      "tags": ["retry", "error-handling", "validation"],
      "complexity": "simple"
    },
    {
      "id": "function:app/sources/base.py:fetch_url",
      "type": "function",
      "name": "fetch_url",
      "filePath": "app/sources/base.py",
      "lineRange": [66, 72],
      "summary": "공통 User-Agent·타임아웃·리다이렉트 추종으로 비동기 GET 을 수행하고 상태 코드를 검사한다. tenacity 로 최대 3회 지수 백오프 재시도가 적용된다.",
      "tags": ["http-client", "retry", "async", "utility"],
      "complexity": "simple"
    },
    {
      "id": "file:app/sources/github_release.py",
      "type": "file",
      "name": "github_release.py",
      "filePath": "app/sources/github_release.py",
      "summary": "관심 저장소의 GitHub Releases 를 폴링해 NormalizedItem 으로 변환하는 수집기. 웹훅이 주 경로이고 이 폴링은 누락 보정용이라 since 로 자르지 않으며, 저장소 하나가 실패해도 나머지는 수집한다.",
      "tags": ["source", "collector", "github", "api-handler", "plugin"],
      "complexity": "moderate",
      "languageNotes": "asyncio.gather 의 return_exceptions=True 로 저장소별 실패를 격리하고, 중복은 DB 의 url_hash 유니크 제약에 맡긴다."
    },
    {
      "id": "function:app/sources/github_release.py:auth_headers",
      "type": "function",
      "name": "auth_headers",
      "filePath": "app/sources/github_release.py",
      "lineRange": [20, 25],
      "summary": "GitHub API 요청 헤더를 만든다. 설정에 토큰이 있으면 Bearer 인증을 붙여 레이트리밋을 완화한다.",
      "tags": ["github", "authentication", "http-client"],
      "complexity": "simple"
    },
    {
      "id": "function:app/sources/github_release.py:release_to_item",
      "type": "function",
      "name": "release_to_item",
      "filePath": "app/sources/github_release.py",
      "lineRange": [28, 48],
      "summary": "릴리즈 JSON 하나를 NormalizedItem 으로 변환한다. 초안(draft)이거나 published_at·html_url 이 없으면 None 을 돌려 버린다. 본문은 3000자로 자르고 category_hint 는 LIBRARY 로 고정한다.",
      "tags": ["normalization", "github", "serialization", "validation"],
      "complexity": "moderate"
    },
    {
      "id": "class:app/sources/github_release.py:GithubReleaseSource",
      "type": "class",
      "name": "GithubReleaseSource",
      "filePath": "app/sources/github_release.py",
      "lineRange": [51, 84],
      "summary": "설정의 repos 목록을 병렬로 조회하는 Source 구현체. 실패한 저장소는 경고 로그만 남기고 건너뛰며, since 를 무시하고 매번 최근 릴리즈를 다시 봐 실패한 저장소가 다음 폴링에서 스스로 복구되게 한다.",
      "tags": ["source", "collector", "github", "async", "fault-tolerance"],
      "complexity": "moderate"
    },
    {
      "id": "file:app/sources/rss.py",
      "type": "file",
      "name": "rss.py",
      "filePath": "app/sources/rss.py",
      "summary": "기업 기술 블로그·arXiv 등에 공통으로 쓰이는 RSS/Atom 수집기. feedparser 로 피드를 파싱해 제목·요약·발행 시각만 사용하고 원문 페이지는 요청하지 않으며, allowed_hosts 로 서드파티 미러 피드의 외부 링크를 걸러낸다.",
      "tags": ["source", "collector", "rss", "serialization", "plugin"],
      "complexity": "moderate",
      "languageNotes": "설정의 allowed_hosts 는 URL 이 아니라 순수 호스트명이라 urlsplit 대신 문자열로 직접 정규화한다."
    },
    {
      "id": "function:app/sources/rss.py:entry_published",
      "type": "function",
      "name": "entry_published",
      "filePath": "app/sources/rss.py",
      "lineRange": [23, 29],
      "summary": "피드 엔트리의 published_parsed 또는 updated_parsed 시간 튜플을 UTC datetime 으로 변환한다. 둘 다 없으면 None 을 반환해 항목을 버리게 한다.",
      "tags": ["rss", "serialization", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:app/sources/rss.py:entry_body",
      "type": "function",
      "name": "entry_body",
      "filePath": "app/sources/rss.py",
      "lineRange": [32, 38],
      "summary": "엔트리 본문을 content, summary, media:description 순으로 찾아 HTML 을 제거하고 3000자로 자른다. YouTube 채널 피드가 media:description 을 쓰는 경우까지 커버한다.",
      "tags": ["rss", "text-processing", "utility"],
      "complexity": "simple"
    },
    {
      "id": "class:app/sources/rss.py:RssSource",
      "type": "class",
      "name": "RssSource",
      "filePath": "app/sources/rss.py",
      "lineRange": [41, 84],
      "summary": "피드 URL 하나를 담당하는 Source 구현체. 링크·제목·발행 시각이 온전하고 allowed_hosts 를 통과하며 since 이후인 엔트리만 NormalizedItem 으로 만든다.",
      "tags": ["source", "collector", "rss", "async", "validation"],
      "complexity": "moderate"
    },
    {
      "id": "file:app/sources/youtube.py",
      "type": "file",
      "name": "youtube.py",
      "filePath": "app/sources/youtube.py",
      "summary": "YouTube 채널 수집기. channel_id 로 채널 RSS 피드 URL 을 만들고 category_hint 를 video 로 채운 설정을 RssSource 에 그대로 넘기는 얇은 어댑터다.",
      "tags": ["source", "collector", "youtube", "factory", "plugin"],
      "complexity": "simple",
      "languageNotes": "별도 클래스를 만들지 않고 pydantic 의 model_copy(update=...) 로 설정만 갈아끼워 RssSource 를 재사용한다."
    },
    {
      "id": "file:tests/conftest.py",
      "type": "file",
      "name": "conftest.py",
      "filePath": "tests/conftest.py",
      "summary": "pytest 공통 설정. app 임포트 전에 DATABASE_URL·API 키 등 필수 환경변수를 더미 값으로 채우고(TEST_DATABASE_URL 이 있으면 우선), 픽스처 파일을 바이트로 읽는 fixture() 헬퍼를 제공한다.",
      "tags": ["test", "config", "utility", "test-setup"],
      "complexity": "simple",
      "languageNotes": "conftest.py 는 테스트 수집 시점에 먼저 실행되므로 환경변수 주입 자리로 쓰인다."
    },
    {
      "id": "file:tests/sources/test_github_release.py",
      "type": "file",
      "name": "test_github_release.py",
      "filePath": "tests/sources/test_github_release.py",
      "summary": "GitHub Releases 수집기 테스트. 초안 릴리즈 제외, since 를 무시해 실패한 저장소가 복구되는 동작, 저장소 하나가 실패해도 나머지는 수집되는 격리 동작을 검증한다.",
      "tags": ["test", "source", "github", "fault-tolerance"],
      "complexity": "simple"
    },
    {
      "id": "file:tests/sources/test_retry.py",
      "type": "file",
      "name": "test_retry.py",
      "filePath": "tests/sources/test_retry.py",
      "summary": "retryable 판별 함수 테스트. 전송 오류·5xx·429 는 재시도 대상이고 401·404 같은 영구 클라이언트 오류와 무관한 예외는 아님을 확인한다.",
      "tags": ["test", "retry", "error-handling"],
      "complexity": "simple"
    },
    {
      "id": "file:tests/sources/test_rss.py",
      "type": "file",
      "name": "test_rss.py",
      "filePath": "tests/sources/test_rss.py",
      "summary": "RSS 수집기와 YouTube 어댑터 테스트. 엔트리 파싱, since 필터링, category_hint 전파, YouTube 피드 URL 형태, allowed_hosts 의 외부 링크 차단과 www 접두사 무시를 검증한다.",
      "tags": ["test", "source", "rss", "validation"],
      "complexity": "simple"
    },
    {
      "id": "file:tests/test_normalize.py",
      "type": "file",
      "name": "test_normalize.py",
      "filePath": "tests/test_normalize.py",
      "summary": "URL 정규화·해시 테스트. 추적 파라미터 제거, 트레일링 슬래시·프래그먼트 처리, 루트 경로 보존, 쿼리 순서가 달라도 같은 해시가 나오는 성질, HTML 제거를 검증한다.",
      "tags": ["test", "normalization", "hashing", "dedupe"],
      "complexity": "simple"
    }
