# Neon pooled 연결 문자열 (pgbouncer, sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# LLM
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
LLM_DAILY_CAP=300

# 임베딩 — 중복·관련 판정과 피드백 사례 검색에 쓴다. 한·영 교차가 필요해 다국어 모델이어야 한다.
#   Voyage: https://dash.voyageai.com → API keys. 기본값.
#   OpenAI 키가 이미 있으면 EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small.
#   모델을 바꾸면 uv run python scripts/backfill_embeddings.py 로 전량 재계산해야 한다.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3.5-lite
VOYAGE_API_KEY=
OPENAI_API_KEY=

# 텔레그램 봇
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=아무_긴_랜덤_문자열

# 디스코드 봇 — 발송 채널. 웹훅 URL 로도 보낼 수는 있지만 👍/👎 버튼(피드백)은 봇만 가능.
#   1) https://discord.com/developers/applications → New Application
#   2) General Information → PUBLIC KEY 복사              → DISCORD_PUBLIC_KEY
#   3) Bot 탭 → Reset Token → 토큰 복사 (한 번만 보임)     → DISCORD_BOT_TOKEN
#   4) OAuth2 → URL Generator → scope: bot / 권한: View Channel, Send Messages, Embed Links
#      → 생성된 URL 열어 내 서버에 초대
#   5) 디스코드 앱 설정 → 고급 → 개발자 모드 ON → 채널 우클릭 → 채널 ID 복사 → DISCORD_CHANNEL_ID
#   6) 배포 후: General Information → Interactions Endpoint URL = https://<도메인>/webhook/discord
#      (저장 시 Discord 가 PING 을 보내므로 서버가 떠 있어야 저장된다)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_PUBLIC_KEY=

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=아무_긴_랜덤_문자열

# 모바일 앱 API (/api/v1) — 베어러 토큰 하나가 단일 사용자(DEFAULT_USER_ID)에 매핑된다.
#   비어 있으면 /api/v1 요청이 전부 401 이다. 앱은 빌드 시 --dart-define=APP_API_TOKEN=... 로 받는다.
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_TOKEN=
# 앱 알림 설정 화면에 보일 디스코드 채널 이름 (표시용).
DISCORD_CHANNEL_NAME=#trend-alerts
# 앱 푸시 (FCM HTTP v1). 서비스 계정 JSON 은 볼륨으로 마운트하고 커밋하지 않는다.
#   docker-compose.yml 의 app 서비스에 volumes: ["./secrets/fcm.json:/run/secrets/fcm.json:ro"] 를 더하고
#   FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json 으로 둔다. 파일이 없으면 FCM 채널은 연결 안 됨이다.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# 런타임
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# 배포 — VM 의 .env 에만 필요하다. docker compose 가 이미지 이름과 도메인을 여기서 읽는다.
#   GHCR_OWNER: ghcr.io/<owner>/tech-radar 의 owner. GHCR 패키지가 public 이라 VM 에서 로그인은 필요 없다.
#   DOMAIN: Caddy 가 이 이름으로 Let's Encrypt 인증서를 자동 발급한다. A 레코드가 VM IP 를 가리켜야 한다.
GHCR_OWNER=yeotaeho
DOMAIN=trend.yeotaeho.kr
